{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "migration:generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "migration:run": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "migration:revert": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
