{
  "name": "@my-binder/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "migration:generate": "node --env-file=.env.local --import tsx ./node_modules/typeorm/cli.js migration:generate src/db/migrations/migration -d src/db/datasource-cli.ts",
    "migration:run": "node --env-file=.env.local --import tsx ./node_modules/typeorm/cli.js migration:run -d src/db/datasource-cli.ts",
    "migration:revert": "node --env-file=.env.local --import tsx ./node_modules/typeorm/cli.js migration:revert -d src/db/datasource-cli.ts",
    "dev": "node --env-file=.env.local --import tsx --watch index.ts",
    "start": "node --env-file=.env.local dist/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@duckdb/node-api": "latest",
    "@fastify/aws-lambda": "^6.0.0",
    "@fastify/caching": "^8.3.0",
    "@fastify/cookie": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@my-binder/core": "workspace:*",
    "abstract-cache": "^1.0.1",
    "fastify": "^4.29.0",
    "fastify-plugin": "^4.5.0",
    "google-auth-library": "^9.0.0",
    "jsonwebtoken": "^9.0.0",
    "mtgjson-sdk": "^0.1.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
