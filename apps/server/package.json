{
  "name": "@my-binder/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias && cp -r src/db/migrations dist/db/",
    "dev": "node --env-file=.env --import tsx --watch index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@duckdb/node-api": "latest",
    "@fastify/aws-lambda": "^6.0.0",
    "@fastify/cookie": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@my-binder/core": "workspace:*",
    "fastify": "^4.29.0",
    "fastify-plugin": "^4.5.0",
    "google-auth-library": "^9.0.0",
    "jsonwebtoken": "^9.0.0",
    "mtgjson-sdk": "^0.1.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
