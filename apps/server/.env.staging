# ─────────────────────────────────────────────
# Staging environment (.env.staging)
# ─────────────────────────────────────────────
# Pre-production AWS environment. Mirrors prod topology (Lambda + Aurora + EFS)
# but points at the staging account / cluster.
# This file is gitignored — fill in values from your deploy config.

# ─── Server ──────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── DuckDB / MTGJSON ────────────────────────
DB_PATH=/mnt/efs/binder.duckdb
MTGJSON_CACHE_DIR=/mnt/efs/mtgjson-cache
CARD_PROVIDER=mtgjson

# ─── PostgreSQL (Aurora staging) ─────────────
DATABASE_URL=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_NAME=my_binder
DATABASE_SECRET_NAME=my-binder/staging/db/password

# ─── Google OAuth ────────────────────────────
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=

# ─── Session JWT ─────────────────────────────
SESSION_JWT_SECRET_NAME=my-binder/staging/session-jwt
