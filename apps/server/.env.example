# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────

# IMPORTANT: Port must be fixed at 3000 for local development.
# Changing this value breaks Google OAuth — http://localhost:3000 must be
# registered as an authorized JavaScript origin in Google Cloud Console.
PORT=3000

NODE_ENV=development

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

# Path to the DuckDB database file.
# In Docker, mount this as a persistent volume.
DB_PATH=./binder.duckdb

# Directory for caching MTGJSON card data.
# In Docker, mount this as a persistent volume.
MTGJSON_CACHE_DIR=./data/mtgjson-cache

CARD_PROVIDER=mtgjson

# ─────────────────────────────────────────────
# PostgreSQL (TypeORM)
# ─────────────────────────────────────────────
#
# Used by:
#   - The Fastify server at runtime (via src/config.ts → initDataSource)
#   - The TypeORM CLI for migration:generate / migration:run / migration:revert
#     (via src/db/datasource-cli.ts)
#
# In Lambda / staging / prod, DATABASE_PASSWORD is fetched from AWS Secrets
# Manager using DATABASE_SECRET_NAME instead — see src/config.ts:resolveSecret.

# Hostname or writer endpoint of the Postgres instance.
# Local dev:  localhost
# Aurora:     my-binder-db.cluster-xxxx.eu-west-1.rds.amazonaws.com
DATABASE_URL=localhost

DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=my_binder

# Optional: in AWS deployments, set this to the Secrets Manager secret name
# that holds the DB password. When set, it overrides DATABASE_PASSWORD above.
# DATABASE_SECRET_NAME=my-binder/db/password

# ─────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────

# Comma-separated list of all authorized Google OAuth client IDs.
# Include iOS, Android, AND web client IDs.
# The web client ID must also appear in GOOGLE_WEB_CLIENT_ID below.
# These are passed as the `audience` to OAuth2Client.verifyIdToken() —
# the primary defence against token substitution attacks.
#
# Example:
#   GOOGLE_CLIENT_IDS=123-ios.apps.googleusercontent.com,456-android.apps.googleusercontent.com,789-web.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# Web OAuth client ID used by the /auth/login browser login page.
# The Google Identity Services (GIS) SDK uses this to render the
# "Sign in with Google" button.
#
# Prerequisites (Google Cloud Console):
#   1. Create an OAuth 2.0 Web client credential.
#   2. Under "Authorized JavaScript origins" add: http://localhost:3000
#   3. No redirect URI is needed for the GIS button/One Tap flow.
#   4. Copy the client ID here AND include it in GOOGLE_CLIENT_IDS above.
#
# Example:
#   GOOGLE_WEB_CLIENT_ID=789-web.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=

# ─────────────────────────────────────────────
# Session JWT
# ─────────────────────────────────────────────

# Secret used to sign and verify HS256 session JWTs.
# Must be at least 32 characters. Use a high-entropy random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_JWT_SECRET=
