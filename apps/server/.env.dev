# ─────────────────────────────────────────────
# Dev environment (.env.dev)
# ─────────────────────────────────────────────
# Shared dev/sandbox AWS environment. Used for integration testing against
# the real Aurora dev cluster before promoting to staging.
# This file is gitignored — fill in values from your deploy config.

# ─── Server ──────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── DuckDB / MTGJSON ────────────────────────
# In Lambda these point at the EFS mount (EFS_PATH overrides MTGJSON_CACHE_DIR).
MTGJSON_CACHE_DIR=/mnt/data/mtgjson-cache
CARD_PROVIDER=mtgjson

# ─── PostgreSQL (Aurora dev) ─────────────────
DATABASE_URL=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_NAME=my_binder
# Password is fetched from Secrets Manager in deployed envs.
DATABASE_SECRET_NAME=my-binder/dev/db/password
DATABASE_SSL=false

# ─── Google OAuth ────────────────────────────
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=

# ─── Session JWT ─────────────────────────────
# In deployed envs, fetched from Secrets Manager.
SESSION_JWT_SECRET_NAME=my-binder/dev/session-jwt
