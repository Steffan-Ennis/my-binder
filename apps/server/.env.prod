# ─────────────────────────────────────────────
# Production environment (.env.prod)
# ─────────────────────────────────────────────
# Production AWS environment. All secrets are resolved from AWS Secrets
# Manager at runtime via the *_SECRET_NAME variables.
# This file is gitignored — fill in values from your deploy config.

# ─── Server ──────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── DuckDB / MTGJSON ────────────────────────
DB_PATH=/mnt/efs/binder.duckdb
MTGJSON_CACHE_DIR=/mnt/efs/mtgjson-cache
CARD_PROVIDER=mtgjson

# ─── PostgreSQL (Aurora prod) ────────────────
DATABASE_URL=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_NAME=my_binder
DATABASE_SECRET_NAME=my-binder/prod/db/password

# ─── Google OAuth ────────────────────────────
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=

# ─── Session JWT ─────────────────────────────
SESSION_JWT_SECRET_NAME=my-binder/prod/session-jwt
