# Mobile workspace environment template — copy to .env.local and fill in.
# Loaded by app.config.ts and surfaced to runtime via expo-constants.

# Base URL of the @my-binder/server API (no trailing slash).
API_BASE_URL=https://localhost:3000

# Google OAuth client IDs (per platform).
# See: https://docs.expo.dev/guides/google-authentication/
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=