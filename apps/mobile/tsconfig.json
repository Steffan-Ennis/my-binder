{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@root/*": [
        "./*"
      ],
      "@src/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "constants/**/*",
    "*.ts",
    "*.tsx"
  ]
}
