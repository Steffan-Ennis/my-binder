# Deploy-time env vars for @my-binder/infrastructure.
#
# Copy to .env.dev (gitignored) and edit locally. Loaded by bin/app.ts via
# process.loadEnvFile() at synth time.

# When synthing/deploying the stack the environment string will be suffixed to the each of the construct names.
ENVIRONMENT=dev

# When true, import the retained secrets (SESSION_JWT_SECRET,
# GOOGLE_CLIENT_IDS, GOOGLE_WEB_CLIENT_ID) from AWS by name instead of
# creating new ones. Set to true after a `cdk destroy` to recover from
# orphaned retained resources. See README.md for details.
REUSE_ORPHANS=false
